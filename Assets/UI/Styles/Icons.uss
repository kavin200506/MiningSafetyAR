/* Icons.uss — Sprite icons for MiningSafetyAR */

/* Bottom Nav Icons (24x24) */
.icon-home {
    width: 24px;
    height: 24px;
    background-size: scale-to-fill;
}
.icon-training {
    width: 24px;
    height: 24px;
    background-size: scale-to-fill;
}
.icon-progress {
    width: 24px;
    height: 24px;
    background-size: scale-to-fill;
}
.icon-settings {
    width: 24px;
    height: 24px;
    background-size: scale-to-fill;
}

/* Module Card Icons (48x48) */
.module-icon-fire {
    width: 48px;
    height: 48px;
    background-size: scale-to-fill;
}
.module-icon-gas {
    width: 48px;
    height: 48px;
    background-size: scale-to-fill;
}
.module-icon-machinery {
    width: 48px;
    height: 48px;
    background-size: scale-to-fill;
}
.module-icon-electrical {
    width: 48px;
    height: 48px;
    background-size: scale-to-fill;
}
.module-icon-heights {
    width: 48px;
    height: 48px;
    background-size: scale-to-fill;
}
.module-icon-default {
    width: 48px;
    height: 48px;
    background-size: scale-to-fill;
}

/* Splash / Login Logo (64x64) */
.logo-shield {
    width: 64px;
    height: 64px;
    background-image: url("project://database/Assets/UI/Sprites/Icons/logo_shield.png");
    background-size: scale-to-fill;
}

/* Dashboard Icons (32x32) */
.avatar-worker {
    width: 32px;
    height: 32px;
    background-size: scale-to-fill;
}
.icon-trophy {
    width: 32px;
    height: 32px;
    background-size: scale-to-fill;
}

/* Learning Content Slide Icons (48x48) */
.slide-icon-fire { width: 48px; height: 48px; background-size: scale-to-fill; }
.slide-icon-extinguisher { width: 48px; height: 48px; background-size: scale-to-fill; }
.slide-icon-evacuation { width: 48px; height: 48px; background-size: scale-to-fill; }
.slide-icon-gas { width: 48px; height: 48px; background-size: scale-to-fill; }
.slide-icon-ppe { width: 48px; height: 48px; background-size: scale-to-fill; }
.slide-icon-confined { width: 48px; height: 48px; background-size: scale-to-fill; }
.slide-icon-lockout { width: 48px; height: 48px; background-size: scale-to-fill; }
.slide-icon-guarding { width: 48px; height: 48px; background-size: scale-to-fill; }
.slide-icon-operation { width: 48px; height: 48px; background-size: scale-to-fill; }
.slide-icon-electrical { width: 48px; height: 48px; background-size: scale-to-fill; }
.slide-icon-gloves { width: 48px; height: 48px; background-size: scale-to-fill; }
.slide-icon-fall { width: 48px; height: 48px; background-size: scale-to-fill; }
.slide-icon-ladder { width: 48px; height: 48px; background-size: scale-to-fill; }
.slide-icon-tip { width: 24px; height: 24px; background-size: scale-to-fill; }

/* AR Simulation Icons (48x48) */
.ar-icon-scan { width: 48px; height: 48px; background-size: scale-to-fill; }
.ar-icon-move { width: 48px; height: 48px; background-size: scale-to-fill; }
.ar-icon-check { width: 48px; height: 48px; background-size: scale-to-fill; }
.ar-icon-fire { width: 48px; height: 48px; background-size: scale-to-fill; }
.ar-icon-extinguisher { width: 48px; height: 48px; background-size: scale-to-fill; }
.ar-icon-unlock { width: 48px; height: 48px; background-size: scale-to-fill; }
