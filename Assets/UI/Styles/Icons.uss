/* Misc Icons (24x24) */
.icon-back { width: 24px; height: 24px; background-size: scale-to-fill; }
.icon-eye { width: 24px; height: 24px; background-size: scale-to-fill; }
.icon-search { width: 24px; height: 24px; background-size: scale-to-fill; }
