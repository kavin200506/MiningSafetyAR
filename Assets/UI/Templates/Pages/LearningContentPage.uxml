<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Theme.uss" />
    <Style src="project://database/Assets/UI/Styles/Reset.uss" />
    <Style src="project://database/Assets/UI/Styles/Components.uss" />
    <Style src="project://database/Assets/UI/Styles/Header.uss" />
    <Style src="project://database/Assets/UI/Styles/Animations.uss" />
    <Style src="project://database/Assets/UI/Styles/Icons.uss" />
    <ui:VisualElement class="page-container">
        <ui:VisualElement class="header">
            <ui:Button class="header__back-btn" name="back-btn" style="background-color: transparent; border-width: 0;">
                <ui:Label text="&lt;" style="font-size: 24px; color: #1A1A1A; font-weight: bold; margin-bottom: 2px;" />
            </ui:Button>
            <ui:Label class="header__title" text="Learn" />
            <ui:Label class="slide-counter" name="slide-counter" text="1/3" style="width: 40px; text-align: center; font-size: 12px; color: #666666;" />
        </ui:VisualElement>
        <ui:VisualElement class="learning__progress-track" name="learning-track" style="height: 3px; background-color: #FFE0B2;">
            <ui:VisualElement class="progress-fill" name="learning-fill" style="height: 100%; background-color: #FF6D00; width: 0%;" />
        </ui:VisualElement>
        <ui:ScrollView class="scroll-area">
            <ui:VisualElement class="slide-card" name="slide-card" style="background-color: #FFFFFF; border-color: #FFE0B2; border-width: 1px; border-radius: 14px; padding: 16px; margin: 16px;">
                <ui:VisualElement class="slide-emoji" name="slide-emoji" style="width: 48px; height: 48px; align-self: center; margin-bottom: 8px;" />
                <ui:Label class="slide-title" name="slide-title" text="" style="font-size: 16px; font-weight: 700; color: #1A1A1A; text-align: center; margin-bottom: 12px;" />
                <ui:VisualElement name="slide-points" style="margin-bottom: 12px;" />
                <ui:VisualElement class="slide-tip" name="slide-tip" style="flex-direction: row; background-color: #FFF3E0; border-radius: 8px; padding: 12px; align-items: center;">
                    <ui:VisualElement class="slide-icon-tip" style="width: 16px; height: 16px; margin-right: 8px;" />
                    <ui:Label class="slide-tip__text" name="tip-text" text="" style="font-size: 12px; color: #666666; flex: 1;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement class="learning__nav" style="flex-direction: row; padding: 12px 16px; border-top-color: #FFE0B2; border-top-width: 1px; background-color: #FFFFFF;">
            <ui:Button class="btn-secondary" name="prev-btn" text="Previous" style="flex: 1; margin-right: 8px;" />
            <ui:Button class="btn-primary" name="next-btn" text="Next" style="flex: 1;" />
            <ui:Button class="btn-primary" name="ready-btn" text="I'm Ready" style="flex: 1; display: none; background-color: #4CAF50;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
