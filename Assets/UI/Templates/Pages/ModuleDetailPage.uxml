<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Theme.uss" />
    <Style src="project://database/Assets/UI/Styles/Reset.uss" />
    <Style src="project://database/Assets/UI/Styles/Components.uss" />
    <Style src="project://database/Assets/UI/Styles/Header.uss" />
    <Style src="project://database/Assets/UI/Styles/BottomNav.uss" />
    <Style src="project://database/Assets/UI/Styles/Tables.uss" />
    <ui:VisualElement class="page-container">
        <ui:VisualElement class="header">
            <ui:Button class="header__back-btn" name="back-btn" text="&#x2190;" />
            <ui:Label class="header__title" name="module-title" text="" />
            <ui:VisualElement class="header__right-action" />
        </ui:VisualElement>
        <ui:ScrollView class="scroll-area">
            <ui:VisualElement class="card" name="hero-section" style="align-items: center; padding: 16px;">
                <ui:Label class="module-hero__emoji" name="hero-emoji" text="" style="font-size: 48px;" />
                <ui:Label class="badge" name="hero-badge" text="" style="margin-top: 8px;" />
            </ui:VisualElement>
            <ui:Label name="description" style="margin: 16px 0; font-size: 13px; color: #666666;" />
            <ui:VisualElement name="meta-row" style="flex-direction: row; margin-bottom: 8px;">
                <ui:VisualElement class="pill" style="flex-direction: row; margin-right: 8px;">
                    <ui:Label text="&#x23F1;" style="margin-right: 4px;" />
                    <ui:Label name="duration" text="45 min" />
                </ui:VisualElement>
                <ui:VisualElement class="pill" style="flex-direction: row; margin-right: 8px;">
                    <ui:Label text="&#x2B50;" style="margin-right: 4px;" />
                    <ui:Label name="difficulty" text="Medium" />
                </ui:VisualElement>
                <ui:VisualElement class="pill" style="flex-direction: row;">
                    <ui:Label text="&#x1F3AF;" style="margin-right: 4px;" />
                    <ui:Label name="domain" text="Fire Safety" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="card" name="best-score-card" style="margin-top: 16px; display: none;">
                <ui:Label text="Best Score" style="font-size: 14px; font-weight: 600; color: #1A1A1A;" />
                <ui:VisualElement class="progress-track" name="best-track" style="height: 6px; background-color: #FFE0B2; border-radius: 3px; margin: 8px 0;">
                    <ui:VisualElement class="progress-fill" style="height: 100%; background-color: #FF6D00; width: 0%;" />
                </ui:VisualElement>
                <ui:Label name="best-score-text" text="" style="font-size: 12px; color: #1A1A1A;" />
                <ui:Label name="attempt-count" text="" style="font-size: 11px; color: #666666;" />
                <ui:Label name="last-attempt" text="" style="font-size: 11px; color: #999999;" />
            </ui:VisualElement>
            <ui:VisualElement style="margin-top: 16px;">
                <ui:Label text="Learning Objectives" style="font-size: 14px; font-weight: 600; color: #1A1A1A; margin-bottom: 8px;" />
                <ui:VisualElement name="objectives-list" />
            </ui:VisualElement>
            <ui:VisualElement name="competency-section" style="margin-top: 16px; display: none;">
                <ui:Label text="Competency Scores" style="font-size: 14px; font-weight: 600; color: #1A1A1A; margin-bottom: 8px;" />
                <ui:VisualElement name="score-bars" />
            </ui:VisualElement>
            <ui:VisualElement style="margin-top: 16px;">
                <ui:Label text="Attempt History" style="font-size: 14px; font-weight: 600; color: #1A1A1A; margin-bottom: 8px;" />
                <ui:VisualElement class="table" name="attempt-table">
                    <ui:VisualElement class="table-header">
                        <ui:Label text="#" style="width: 30px; font-size: 11px; color: #999999;" />
                        <ui:Label text="Date" style="flex: 1; font-size: 11px; color: #999999;" />
                        <ui:Label text="Score" style="width: 60px; font-size: 11px; color: #999999;" />
                        <ui:Label text="Status" style="width: 60px; font-size: 11px; color: #999999;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="table-body" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="action-section" style="margin-top: 24px;">
                <ui:Button class="btn-primary" name="action-btn" text="START TRAINING" />
                <ui:Button class="btn-secondary" name="cert-btn" text="VIEW CERTIFICATE" style="display: none; margin-top: 8px;" />
                <ui:VisualElement name="locked-message" style="display: none; align-items: center; margin-top: 12px;">
                    <ui:Label text="&#x1F512;" style="font-size: 24px;" />
                    <ui:Label text="Complete previous modules to unlock" style="color: #999999; font-size: 13px; text-align: center;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="height: 80px;" />
        </ui:ScrollView>
        <ui:VisualElement name="bottom-nav" class="bottom-nav">
            <ui:Button name="tab-home" class="bottom-nav__tab">
                <ui:Label text="&#x2302;" style="font-size: 18px;" />
                <ui:Label class="bottom-nav__tab-label" text="Home" />
            </ui:Button>
            <ui:Button name="tab-training" class="bottom-nav__tab bottom-nav__tab--active">
                <ui:Label text="&#x1F4DA;" style="font-size: 18px;" />
                <ui:Label class="bottom-nav__tab-label" text="Training" />
            </ui:Button>
            <ui:Button name="tab-progress" class="bottom-nav__tab">
                <ui:Label text="&#x1F4CA;" style="font-size: 18px;" />
                <ui:Label class="bottom-nav__tab-label" text="Progress" />
            </ui:Button>
            <ui:Button name="tab-settings" class="bottom-nav__tab">
                <ui:Label text="&#x2699;" style="font-size: 18px;" />
                <ui:Label class="bottom-nav__tab-label" text="Settings" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
