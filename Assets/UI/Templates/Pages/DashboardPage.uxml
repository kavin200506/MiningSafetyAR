<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Theme.uss" />
    <Style src="project://database/Assets/UI/Styles/Reset.uss" />
    <Style src="project://database/Assets/UI/Styles/Components.uss" />
    <Style src="project://database/Assets/UI/Styles/Header.uss" />
    <Style src="project://database/Assets/UI/Styles/BottomNav.uss" />
    <ui:VisualElement class="page-container">
        <ui:ScrollView class="scroll-area">
            <ui:VisualElement class="dashboard__greeting" name="greeting-bar" style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <ui:VisualElement class="greeting__left">
                    <ui:Label class="greeting__text" name="greeting-text" text="Hello, Ramesh" style="font-size: 18px; font-weight: 700; color: #1A1A1A;" />
                    <ui:Label class="greeting__sub" name="greeting-sub" text="Stay safe, stay certified" style="font-size: 12px; color: #666666;" />
                </ui:VisualElement>
                <ui:VisualElement class="greeting__avatar" name="avatar" style="width: 40px; height: 40px; border-radius: 20px; background-color: #FFF3E0; align-items: center; justify-content: center;">
                    <ui:Label text="&#x1F477;" style="font-size: 20px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="card" name="progress-card" style="margin-bottom: 20px;">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                    <ui:Label text="Overall Progress" style="font-size: 14px; font-weight: 600; color: #1A1A1A;" />
                    <ui:Label name="progress-value" text="68%" style="font-size: 18px; font-weight: 700; color: #FF6D00;" />
                </ui:VisualElement>
                <ui:VisualElement class="progress-track" name="overall-track" style="height: 6px; background-color: #FFE0B2; border-radius: 3px; margin: 12px 0;">
                    <ui:VisualElement class="progress-fill" style="height: 100%; background-color: #FF6D00; width: 68%;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; justify-content: space-around; margin-top: 8px;">
                    <ui:VisualElement style="align-items: center;">
                        <ui:Label name="completed-count" text="2" style="font-size: 18px; font-weight: 700; color: #1A1A1A;" />
                        <ui:Label text="Completed" style="font-size: 10px; color: #999999;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="align-items: center;">
                        <ui:Label name="cert-count" text="2" style="font-size: 18px; font-weight: 700; color: #1A1A1A;" />
                        <ui:Label text="Certificates" style="font-size: 10px; color: #999999;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="align-items: center;">
                        <ui:Label name="attempts-count" text="7" style="font-size: 18px; font-weight: 700; color: #1A1A1A;" />
                        <ui:Label text="Attempts" style="font-size: 10px; color: #999999;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="section-header">
                <ui:Label class="section-title" text="Training Modules" />
                <ui:Button class="btn-text" name="see-all-btn" text="See All" />
            </ui:VisualElement>
            <ui:VisualElement name="module-list" />
            <ui:VisualElement class="card-accent" name="cert-banner" style="margin-top: 16px;">
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:Label text="&#x1F3C6;" style="font-size: 28px; margin-right: 12px;" />
                    <ui:VisualElement>
                        <ui:Label text="Your Certificates" style="font-size: 14px; font-weight: 600; color: #1A1A1A;" />
                        <ui:Label name="cert-banner-sub" text="2 certificates earned" style="font-size: 12px; color: #666666;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button class="btn-primary" name="view-certs-btn" text="View All" style="margin-top: 12px;" />
            </ui:VisualElement>
            <ui:VisualElement style="height: 80px;" />
        </ui:ScrollView>
        <!-- BottomNav -->
        <ui:VisualElement name="bottom-nav" class="bottom-nav">
            <ui:Button name="tab-home" class="bottom-nav__tab bottom-nav__tab--active">
                <ui:Label text="&#x2302;" style="font-size: 18px;" />
                <ui:Label class="bottom-nav__tab-label" text="Home" />
            </ui:Button>
            <ui:Button name="tab-training" class="bottom-nav__tab">
                <ui:Label text="&#x1F4DA;" style="font-size: 18px;" />
                <ui:Label class="bottom-nav__tab-label" text="Training" />
            </ui:Button>
            <ui:Button name="tab-progress" class="bottom-nav__tab">
                <ui:Label text="&#x1F4CA;" style="font-size: 18px;" />
                <ui:Label class="bottom-nav__tab-label" text="Progress" />
            </ui:Button>
            <ui:Button name="tab-settings" class="bottom-nav__tab">
                <ui:Label text="&#x2699;" style="font-size: 18px;" />
                <ui:Label class="bottom-nav__tab-label" text="Settings" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
