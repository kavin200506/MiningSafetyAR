<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Theme.uss" />
    <Style src="project://database/Assets/UI/Styles/Reset.uss" />
    <Style src="project://database/Assets/UI/Styles/Components.uss" />
    <Style src="project://database/Assets/UI/Styles/Header.uss" />
    <Style src="project://database/Assets/UI/Styles/BottomNav.uss" />
    <Style src="project://database/Assets/UI/Styles/Icons.uss" />
    
    <ui:VisualElement class="page-container" style="background-color: #F5F7FA;">
        <ui:ScrollView class="scroll-area" style="flex: 1;">
            
            <!-- Dynamic Orange Hero Header -->
            <ui:VisualElement style="background-color: rgb(255, 109, 0); padding: 32px 20px 72px 20px; border-bottom-left-radius: 40px; border-bottom-right-radius: 40px;">
                <ui:VisualElement class="dashboard__greeting" name="greeting-bar" style="flex-direction: row; justify-content: space-between; align-items: center;">
                    <ui:VisualElement class="greeting__left">
                        <ui:Label class="greeting__text" name="greeting-text" text="Hello, User" style="font-size: 24px; font-weight: 700; color: #FFFFFF; -unity-font-style: bold;" />
                        <ui:Label class="greeting__sub" name="greeting-sub" text="Stay safe, stay certified" style="font-size: 14px; color: rgb(255, 224, 178); margin-top: 4px;" />
                    </ui:VisualElement>
                    <ui:Button class="greeting__avatar" name="avatar-btn" style="width: 56px; height: 56px; border-radius: 28px; background-color: #FFFFFF; align-items: center; justify-content: center; border-width: 3px; border-color: rgba(255, 255, 255, 0.5); padding: 0;">
                        <ui:Label text="U" style="font-size: 28px; font-weight: 700; color: rgb(255, 109, 0); -unity-font-style: bold;" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Floating Progress Card (Overlaps the header) -->
            <ui:VisualElement style="padding: 0 16px; margin-top: -48px;">
                <ui:VisualElement class="card" name="progress-card" style="background-color: #FFFFFF; border-radius: 24px; padding: 24px; border-width: 1px; border-color: #E0E0E0; box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.05); margin-bottom: 24px;">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                        <ui:Label text="Overall Progress" style="font-size: 16px; font-weight: 700; color: #1A1A1A; -unity-font-style: bold;" />
                        <ui:VisualElement style="background-color: #FFF3E0; padding: 6px 12px; border-radius: 12px;">
                            <ui:Label name="progress-value" text="0%" style="font-size: 16px; font-weight: 700; color: rgb(255, 109, 0); -unity-font-style: bold;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    
                    <ui:VisualElement class="progress-track" name="overall-track" style="height: 10px; background-color: #F5F5F5; border-radius: 5px; margin: 20px 0; overflow: hidden;">
                        <ui:VisualElement class="progress-fill" name="progress-fill" style="height: 100%; background-color: rgb(255, 109, 0); width: 0%;" />
                    </ui:VisualElement>
                    
                    <!-- Stats Row -->
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-top: 8px;">
                        <ui:VisualElement style="align-items: center; flex: 1;">
                            <ui:Label name="completed-count" text="0" style="font-size: 22px; font-weight: 700; color: #1A1A1A; -unity-font-style: bold;" />
                            <ui:Label text="Completed" style="font-size: 11px; font-weight: 600; color: rgb(153, 153, 153); -unity-font-style: bold; margin-top: 4px;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="width: 1px; height: 32px; background-color: #F0F0F0;" />
                        <ui:VisualElement style="align-items: center; flex: 1;">
                            <ui:Label name="cert-count" text="0" style="font-size: 22px; font-weight: 700; color: #1A1A1A; -unity-font-style: bold;" />
                            <ui:Label text="Certificates" style="font-size: 11px; font-weight: 600; color: rgb(153, 153, 153); -unity-font-style: bold; margin-top: 4px;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="width: 1px; height: 32px; background-color: #F0F0F0;" />
                        <ui:VisualElement style="align-items: center; flex: 1;">
                            <ui:Label name="attempts-count" text="0" style="font-size: 22px; font-weight: 700; color: #1A1A1A; -unity-font-style: bold;" />
                            <ui:Label text="Attempts" style="font-size: 11px; font-weight: 600; color: rgb(153, 153, 153); -unity-font-style: bold; margin-top: 4px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Training Modules Section -->
                <ui:VisualElement class="section-header" style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-left: 4px;">
                    <ui:Label class="section-title" text="Continue Learning" style="font-size: 18px; font-weight: 700; color: #1A1A1A; -unity-font-style: bold;" />
                    <ui:Button class="btn-text" name="see-all-btn" text="See All" style="font-size: 14px; font-weight: 700; color: rgb(255, 109, 0); -unity-font-style: bold; background-color: transparent; border-width: 0;" />
                </ui:VisualElement>
                
                <ui:VisualElement name="module-list" style="margin-bottom: 12px;" />
                
                <ui:VisualElement style="height: 100px;" />
            </ui:VisualElement>
        </ui:ScrollView>
        
        <!-- BottomNav -->
        <ui:VisualElement name="bottom-nav" class="bottom-nav">
            <ui:Button name="tab-home" class="bottom-nav__tab bottom-nav__tab--active">
                <ui:VisualElement class="icon-home" style="margin-bottom: 2px; width: 32px;" />
                <ui:Label text="Home" class="bottom-nav__tab-label" style="-unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Rajdhani/Rajdhani-Medium.ttf?fileID=12800000&amp;guid=e667d5aeff8d1314eb115a34c389a259&amp;type=3#Rajdhani-Medium&quot;);" />
            </ui:Button>
            <ui:Button name="tab-training" class="bottom-nav__tab">
                <ui:VisualElement class="icon-training" style="margin-bottom: 2px; width: 36px;" />
                <ui:Label text="Training" class="bottom-nav__tab-label" style="-unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Rajdhani/Rajdhani-Medium.ttf?fileID=12800000&amp;guid=e667d5aeff8d1314eb115a34c389a259&amp;type=3#Rajdhani-Medium&quot;);" />
            </ui:Button>
            <ui:Button name="tab-progress" class="bottom-nav__tab">
                <ui:VisualElement class="icon-progress" style="margin-bottom: 2px;" />
                <ui:Label text="Progress" class="bottom-nav__tab-label" style="-unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Rajdhani/Rajdhani-Medium.ttf?fileID=12800000&amp;guid=e667d5aeff8d1314eb115a34c389a259&amp;type=3#Rajdhani-Medium&quot;);" />
            </ui:Button>
            <ui:Button name="tab-settings" class="bottom-nav__tab">
                <ui:VisualElement class="icon-settings" style="margin-bottom: 2px;" />
                <ui:Label text="Settings" class="bottom-nav__tab-label" style="-unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Rajdhani/Rajdhani-Medium.ttf?fileID=12800000&amp;guid=e667d5aeff8d1314eb115a34c389a259&amp;type=3#Rajdhani-Medium&quot;);" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
