<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Theme.uss" />
    <Style src="project://database/Assets/UI/Styles/Reset.uss" />
    <Style src="project://database/Assets/UI/Styles/Components.uss" />
    <Style src="project://database/Assets/UI/Styles/Header.uss" />
    <Style src="project://database/Assets/UI/Styles/BottomNav.uss" />
    <Style src="project://database/Assets/UI/Styles/Icons.uss" />
    <Style src="project://database/Assets/UI/Styles/Tables.uss" />
    
    <ui:VisualElement class="page-container" style="background-color: rgb(245, 247, 250);">
        <ui:ScrollView class="scroll-area" style="flex: 1;">
            
            <!-- Dynamic Orange Hero Header -->
            <ui:VisualElement style="background-color: rgb(255, 109, 0); padding: 32px 20px 80px 20px; border-bottom-left-radius: 40px; border-bottom-right-radius: 40px;">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                    <!-- Back Button Placeholder / Title -->
                    <ui:Label text="Your Progress" style="font-size: 28px; font-weight: 700; color: rgb(255, 255, 255); -unity-font-style: bold;" />
                    <ui:Button name="avatar-btn" style="width: 40px; height: 40px; background-color: rgb(255, 255, 255); border-radius: 20px; border-width: 0; align-items: center; justify-content: center; padding: 0;">
                        <ui:Label text="U" style="font-size: 20px; font-weight: 700; color: rgb(255, 109, 0); -unity-font-style: bold;" />
                        <ui:VisualElement style="position: absolute; top: -2px; right: -2px; width: 14px; height: 14px; background-color: rgb(255, 109, 0); border-radius: 7px; align-items: center; justify-content: center; border-width: 2px; border-color: rgb(255, 255, 255);">
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>
                <ui:Label text="Track your safety certifications and skills." style="font-size: 14px; color: rgb(255, 224, 178); white-space: normal;" />
            </ui:VisualElement>

            <!-- Floating Progress Card (Overlaps the header) -->
            <ui:VisualElement style="padding: 0 16px; margin-top: -48px;">
                <ui:VisualElement class="card" name="top-overview-card" style="background-color: rgb(255, 255, 255); border-radius: 24px; padding: 24px; border-width: 1px; border-color: rgb(230, 230, 230); box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.05); margin-bottom: 24px;">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                        <ui:Label text="Overall Progress" style="font-size: 16px; font-weight: 700; color: rgb(26, 26, 26); -unity-font-style: bold;" />
                        <ui:VisualElement style="background-color: rgb(255, 243, 224); padding: 6px 12px; border-radius: 12px;">
                            <ui:Label name="overall-progress" text="0%" style="font-size: 16px; font-weight: 700; color: rgb(255, 109, 0); -unity-font-style: bold;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    
                    <ui:VisualElement class="progress-track" name="overview-track" style="height: 10px; background-color: rgb(245, 245, 245); border-radius: 5px; margin: 20px 0; overflow: hidden;">
                        <ui:VisualElement class="progress-fill" name="progress-fill" style="height: 100%; background-color: rgb(255, 109, 0); width: 0%;" />
                    </ui:VisualElement>
                    
                    <!-- Stats Row -->
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-top: 8px;">
                        <ui:VisualElement style="align-items: center; flex: 1;">
                            <ui:Label name="completed-count" text="0" style="font-size: 22px; font-weight: 700; color: rgb(26, 26, 26); -unity-font-style: bold;" />
                            <ui:Label text="Completed" style="font-size: 11px; font-weight: 600; color: rgb(153, 153, 153); -unity-font-style: bold; margin-top: 4px;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="width: 1px; height: 32px; background-color: rgb(240, 240, 240);" />
                        <ui:VisualElement style="align-items: center; flex: 1;">
                            <ui:Label name="cert-count" text="0" style="font-size: 22px; font-weight: 700; color: rgb(26, 26, 26); -unity-font-style: bold;" />
                            <ui:Label text="Certificates" style="font-size: 11px; font-weight: 600; color: rgb(153, 153, 153); -unity-font-style: bold; margin-top: 4px;" />
                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Competency Scores -->
                <ui:Label text="Competency Scores" style="font-size: 18px; font-weight: 700; color: rgb(26, 26, 26); -unity-font-style: bold; margin-bottom: 12px; padding-left: 4px;" />
                <ui:VisualElement class="card" style="background-color: rgb(255, 255, 255); border-radius: 20px; padding: 20px; margin-bottom: 24px; border-width: 1px; border-color: rgb(230, 230, 230);">
                    <ui:VisualElement name="competency-bars" />
                </ui:VisualElement>

                <!-- Module Progress -->
                <ui:Label text="Module Progress" style="font-size: 18px; font-weight: 700; color: rgb(26, 26, 26); -unity-font-style: bold; margin-bottom: 12px; padding-left: 4px;" />
                <ui:VisualElement class="card" style="background-color: rgb(255, 255, 255); border-radius: 20px; padding: 12px; margin-bottom: 24px; border-width: 1px; border-color: rgb(230, 230, 230);">
                    <ui:VisualElement name="module-rows" />
                </ui:VisualElement>


                
                <ui:VisualElement style="height: 100px;" />
            </ui:VisualElement>
        </ui:ScrollView>
        
        <!-- Bottom Nav -->
        <ui:VisualElement name="bottom-nav" class="bottom-nav">
            <ui:Button name="tab-home" class="bottom-nav__tab">
                <ui:VisualElement class="icon-home" style="margin-bottom: 2px; width: 32px;" />
                <ui:Label text="Home" class="bottom-nav__tab-label" style="-unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Rajdhani/Rajdhani-Medium.ttf?fileID=12800000&amp;guid=e667d5aeff8d1314eb115a34c389a259&amp;type=3#Rajdhani-Medium&quot;);" />
            </ui:Button>
            <ui:Button name="tab-training" class="bottom-nav__tab">
                <ui:VisualElement class="icon-training" style="margin-bottom: 2px; width: 36px;" />
                <ui:Label text="Training" class="bottom-nav__tab-label" style="-unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Rajdhani/Rajdhani-Medium.ttf?fileID=12800000&amp;guid=e667d5aeff8d1314eb115a34c389a259&amp;type=3#Rajdhani-Medium&quot;);" />
            </ui:Button>
            <ui:Button name="tab-progress" class="bottom-nav__tab bottom-nav__tab--active">
                <ui:VisualElement class="icon-progress" style="margin-bottom: 2px;" />
                <ui:Label text="Progress" class="bottom-nav__tab-label" style="-unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Rajdhani/Rajdhani-Medium.ttf?fileID=12800000&amp;guid=e667d5aeff8d1314eb115a34c389a259&amp;type=3#Rajdhani-Medium&quot;);" />
            </ui:Button>
            <ui:Button name="tab-settings" class="bottom-nav__tab">
                <ui:VisualElement class="icon-settings" style="margin-bottom: 2px;" />
                <ui:Label text="Settings" class="bottom-nav__tab-label" style="-unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Rajdhani/Rajdhani-Medium.ttf?fileID=12800000&amp;guid=e667d5aeff8d1314eb115a34c389a259&amp;type=3#Rajdhani-Medium&quot;);" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
