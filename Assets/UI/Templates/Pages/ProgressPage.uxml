<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Theme.uss?fileID=7433441132597879392&amp;guid=9c058c37ebd69534dae984e55ac8de84&amp;type=3#Theme"/>
    <Style src="project://database/Assets/UI/Styles/Reset.uss?fileID=7433441132597879392&amp;guid=2221f5ca94566ea48871403dc278208b&amp;type=3#Reset"/>
    <Style src="project://database/Assets/UI/Styles/Components.uss?fileID=7433441132597879392&amp;guid=95ed0fa63ed8f1b40bbf80091559f46b&amp;type=3#Components"/>
    <Style src="project://database/Assets/UI/Styles/Header.uss?fileID=7433441132597879392&amp;guid=4aa99dd6c3c3ee74f8efa10450679978&amp;type=3#Header"/>
    <Style src="project://database/Assets/UI/Styles/BottomNav.uss?fileID=7433441132597879392&amp;guid=2efbc4ad3addbec42b50c21c4d27ada6&amp;type=3#BottomNav"/>
    <Style src="project://database/Assets/UI/Styles/Icons.uss?fileID=7433441132597879392&amp;guid=27bbf8a071ea19e42b8b10e5dd4bf912&amp;type=3#Icons"/>
    <Style src="project://database/Assets/UI/Styles/Tables.uss?fileID=7433441132597879392&amp;guid=9e942b0b59cf32e4696e469823af59c5&amp;type=3#Tables"/>
    <ui:VisualElement class="page-container" style="flex-grow: 1; background-color: rgb(255, 255, 255);">
        <ui:VisualElement class="header" style="flex-direction: row; align-items: center; justify-content: space-between; height: 64px; background-color: rgb(255, 255, 255); padding: 0 24px; border-bottom-color: rgb(255, 109, 0); border-bottom-width: 3px;">
            <ui:Label text="Progress" class="header__title" style="font-size: 20px; font-weight: 700; color: rgb(26, 26, 26); -unity-font-style: bold;"/>
            <ui:Button name="notification-btn" style="width: 40px; height: 40px; border-width: 0; background-color: transparent; align-items: center; justify-content: center; overflow: visible;">
                <ui:VisualElement name="icon-bell" style="width: 24px; height: 24px; background-color: transparent; border-width: 2px; border-color: rgb(26, 26, 26); border-radius: 12px; -unity-background-scale-mode: scale-to-fit;"/>
                <ui:VisualElement style="position: absolute; top: 4px; right: 4px; width: 16px; height: 16px; background-color: rgb(255, 109, 0); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="3" style="font-size: 10px; color: rgb(255, 255, 255); -unity-font-style: bold;"/>
                </ui:VisualElement>
            </ui:Button>
        </ui:VisualElement>
        <ui:ScrollView class="scroll-area" style="flex: 1; width: 100%;">
            <ui:VisualElement style="padding: 24px;">
                <ui:VisualElement name="top-overview-card" style="width: 100%; min-height: 280px; border-radius: 20px; background-color: rgb(255, 248, 240); margin-bottom: 24px; padding: 24px; align-items: center; justify-content: space-between; border-width: 1px; border-color: rgb(255, 224, 178); overflow: hidden;">
                    <ui:VisualElement name="card-bg-image" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; opacity: 0.5;"/>
                    <ui:VisualElement style="width: 140px; height: 140px; border-radius: 70px; border-width: 6px; border-color: rgb(255, 224, 178); align-items: center; justify-content: center; background-color: rgb(255, 255, 255); margin-bottom: 24px; z-index: 1;">
                        <ui:Label text="0%" style="font-size: 36px; font-weight: 800; color: rgb(255, 109, 0); -unity-font-style: bold;"/>
                        <ui:Label text="Overall Progress" style="font-size: 11px; color: rgb(102, 102, 102);"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="width: 100%; height: 12px; background-color: rgb(255, 224, 178); border-radius: 6px; margin-bottom: 24px; z-index: 1;"/>
                    <ui:VisualElement style="flex-direction: row; justify-content: space-around; width: 100%; z-index: 1;">
                        <ui:VisualElement style="align-items: center;">
                            <ui:VisualElement name="icon-completed" style="width: 24px; height: 24px; margin-bottom: 8px; border-radius: 12px; border-width: 1px; border-color: rgb(255, 109, 0); align-items: center; justify-content: center; -unity-background-scale-mode: scale-to-fit;">
                                <ui:Label text="✓" style="color: rgb(255, 109, 0); font-size: 12px;"/>
                            </ui:VisualElement>
                            <ui:Label text="2" style="font-size: 16px; font-weight: 700; color: rgb(26, 26, 26); -unity-font-style: bold;"/>
                            <ui:Label text="Completed" style="font-size: 11px; color: rgb(102, 102, 102);"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="width: 1px; height: 40px; background-color: rgb(255, 224, 178); margin-top: 8px;"/>
                        <ui:VisualElement style="align-items: center;">
                            <ui:VisualElement name="icon-target" style="width: 24px; height: 24px; margin-bottom: 8px; border-radius: 12px; border-width: 1px; border-color: rgb(255, 109, 0); align-items: center; justify-content: center; -unity-background-scale-mode: scale-to-fit;">
                                <ui:Label text="◎" style="color: rgb(255, 109, 0); font-size: 12px;"/>
                            </ui:VisualElement>
                            <ui:Label text="7" style="font-size: 16px; font-weight: 700; color: rgb(26, 26, 26); -unity-font-style: bold;"/>
                            <ui:Label text="Total Attempts" style="font-size: 11px; color: rgb(102, 102, 102);"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="width: 1px; height: 40px; background-color: rgb(255, 224, 178); margin-top: 8px;"/>
                        <ui:VisualElement style="align-items: center;">
                            <ui:VisualElement name="icon-ribbon" style="width: 24px; height: 24px; margin-bottom: 8px; border-radius: 12px; border-width: 1px; border-color: rgb(255, 109, 0); align-items: center; justify-content: center; -unity-background-scale-mode: scale-to-fit;">
                                <ui:Label text="★" style="color: rgb(255, 109, 0); font-size: 12px;"/>
                            </ui:VisualElement>
                            <ui:Label text="2" style="font-size: 16px; font-weight: 700; color: rgb(26, 26, 26); -unity-font-style: bold;"/>
                            <ui:Label text="Certificates" style="font-size: 11px; color: rgb(102, 102, 102);"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="card-competency" class="card" style="width: 100%; flex-direction: row; align-items: center; padding: 16px; background-color: rgb(255, 255, 255); border-radius: 16px; border-width: 0; margin-bottom: 16px;">
                    <ui:VisualElement style="width: 48px; height: 48px; background-color: rgb(240, 237, 250); border-radius: 12px; align-items: center; justify-content: center; margin-right: 16px;">
                        <ui:VisualElement name="icon-trophy" style="width: 24px; height: 24px; -unity-background-scale-mode: scale-to-fit;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex: 1; justify-content: center;">
                        <ui:Label text="Competency Scores" style="font-size: 15px; font-weight: 700; color: rgb(26, 26, 26); -unity-font-style: bold; margin-bottom: 4px;"/>
                        <ui:Label text="View your detailed competency performance" style="font-size: 12px; color: rgb(102, 102, 102);"/>
                    </ui:VisualElement>
                    <ui:Label text="&gt;" style="font-size: 18px; color: rgb(153, 153, 153); margin-left: 12px; -unity-font-style: bold;"/>
                </ui:Button>
                <ui:Button name="card-module-progress" class="card" style="width: 100%; flex-direction: row; align-items: center; padding: 16px; background-color: rgb(255, 255, 255); border-radius: 16px; border-width: 0; margin-bottom: 32px;">
                    <ui:VisualElement style="width: 48px; height: 48px; background-color: rgb(227, 242, 253); border-radius: 12px; align-items: center; justify-content: center; margin-right: 16px;">
                        <ui:VisualElement name="icon-chart" style="width: 24px; height: 24px; -unity-background-scale-mode: scale-to-fit;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex: 1; justify-content: center;">
                        <ui:Label text="Module Progress" style="font-size: 15px; font-weight: 700; color: rgb(26, 26, 26); -unity-font-style: bold; margin-bottom: 4px;"/>
                        <ui:Label text="Track progress across all modules" style="font-size: 12px; color: rgb(102, 102, 102);"/>
                    </ui:VisualElement>
                    <ui:Label text="&gt;" style="font-size: 18px; color: rgb(153, 153, 153); margin-left: 12px; -unity-font-style: bold;"/>
                </ui:Button>
                <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:VisualElement name="icon-clock" style="width: 20px; height: 20px; border-width: 2px; border-color: rgb(255, 109, 0); border-radius: 10px; margin-right: 8px; align-items: center; justify-content: center;">
                            <ui:VisualElement style="width: 2px; height: 6px; background-color: rgb(255, 109, 0); position: absolute; top: 3px;"/>
                            <ui:VisualElement style="width: 6px; height: 2px; background-color: rgb(255, 109, 0); position: absolute; left: 9px;"/>
                        </ui:VisualElement>
                        <ui:Label text="Attempt History" style="font-size: 18px; font-weight: 700; color: rgb(26, 26, 26); -unity-font-style: bold;"/>
                    </ui:VisualElement>
                    <ui:Button text="View All" style="font-size: 14px; font-weight: 700; color: rgb(255, 109, 0); -unity-font-style: bold; background-color: transparent; border-width: 0;"/>
                </ui:VisualElement>
                <ui:VisualElement class="table" style="width: 100%; border-radius: 12px; overflow: hidden; background-color: rgb(249, 249, 249); margin-bottom: 24px; border-width: 1px; border-color: rgb(238, 238, 238);">
                    <ui:VisualElement class="table-header" style="flex-direction: row; padding: 12px 16px; border-bottom-width: 1px; border-bottom-color: rgb(238, 238, 238); background-color: rgb(245, 245, 245); width: 337px; height: 40px;">
                        <ui:Label text="Module" style="flex: 1; font-size: 12px; color: rgb(102, 102, 102); -unity-text-align: middle-center; align-self: auto;"/>
                        <ui:Label text="Date" style="width: 87px; font-size: 12px; color: rgb(102, 102, 102); -unity-text-align: upper-center; height: 18px;"/>
                        <ui:Label text="Score" style="width: 60px; font-size: 12px; color: rgb(102, 102, 102); -unity-text-align: middle-center;"/>
                        <ui:Label text="Status" style="width: 59px; font-size: 12px; color: rgb(102, 102, 102); -unity-text-align: middle-right;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="height: 100px;"/>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement name="bottom-nav" class="bottom-nav" style="position: absolute; bottom: 0; left: 0; right: 0; height: 80px; background-color: rgb(255, 255, 255); flex-direction: row; border-top-width: 1px; border-top-color: rgb(238, 238, 238); align-items: center; justify-content: space-around; padding: 0 8px;">
            <ui:Button name="tab-home" style="flex: 1; height: 64px; background-color: transparent; border-width: 0; align-items: center; justify-content: center;">
                <ui:VisualElement class="icon-home" style="width: 24px; height: 24px; margin-bottom: 4px;"/>
                <ui:Label text="Home" style="font-size: 11px; color: rgb(102, 102, 102); font-weight: 600;"/>
            </ui:Button>
            <ui:Button name="tab-training" style="flex: 1; height: 64px; background-color: transparent; border-width: 0; align-items: center; justify-content: center;">
                <ui:VisualElement class="icon-training" style="width: 24px; height: 24px; margin-bottom: 4px;"/>
                <ui:Label text="Training" style="font-size: 11px; color: rgb(102, 102, 102); font-weight: 600;"/>
            </ui:Button>
            <ui:Button name="tab-progress" style="width: 80px; height: 64px; background-color: rgb(255, 243, 224); border-width: 0; border-radius: 20px; align-items: center; justify-content: center; margin: 0 4px;">
                <ui:VisualElement class="icon-progress" style="width: 24px; height: 24px; margin-bottom: 4px;"/>
                <ui:Label text="Progress" style="font-size: 11px; color: rgb(255, 109, 0); font-weight: 700; -unity-font-style: bold;"/>
            </ui:Button>
            <ui:Button name="tab-settings" style="flex: 1; height: 64px; background-color: transparent; border-width: 0; align-items: center; justify-content: center;">
                <ui:VisualElement class="icon-settings" style="width: 24px; height: 24px; margin-bottom: 4px;"/>
                <ui:Label text="Settings" style="font-size: 11px; color: rgb(102, 102, 102); font-weight: 600;"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
