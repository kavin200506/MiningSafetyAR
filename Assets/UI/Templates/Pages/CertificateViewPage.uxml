<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Theme.uss" />
    <Style src="project://database/Assets/UI/Styles/Reset.uss" />
    <Style src="project://database/Assets/UI/Styles/Components.uss" />
    <Style src="project://database/Assets/UI/Styles/Header.uss" />
    <Style src="project://database/Assets/UI/Styles/BottomNav.uss" />
    <Style src="project://database/Assets/UI/Styles/Icons.uss" />
    <ui:VisualElement class="page-container">
        <!-- Top Header -->
        <ui:VisualElement class="header">
            <ui:Button class="header__back-btn" name="back-btn">
                <ui:VisualElement class="icon-back" style="width: 20px; height: 20px;" />
            </ui:Button>
            <ui:Label class="header__title" text="My Safety Certificates" />
            <ui:VisualElement class="header__right-action" />
        </ui:VisualElement>

        <ui:ScrollView class="scroll-area">
            <!-- Module Switcher Tabs / Selector Bar -->
            <ui:VisualElement name="cert-tabs" style="flex-direction: row; margin: 12px 16px 4px 16px; justify-content: space-around; background-color: #F5F5F5; padding: 4px; border-radius: 8px;">
                <ui:Button name="tab-mod-fire" class="btn-secondary" text="Fire Safety" style="flex: 1; height: 32px; font-size: 11px; margin-right: 4px; border-radius: 6px;" />
                <ui:Button name="tab-mod-gas" class="btn-secondary" text="Gas Leak" style="flex: 1; height: 32px; font-size: 11px; margin-right: 4px; border-radius: 6px;" />
                <ui:Button name="tab-mod-all" class="btn-secondary" text="All Certs" style="flex: 1; height: 32px; font-size: 11px; border-radius: 6px;" />
            </ui:VisualElement>

            <!-- Main Official Certificate Card -->
            <ui:VisualElement class="card" name="cert-card" style="padding: 0; overflow: hidden; margin: 12px 16px;">
                <!-- Orange Header Banner -->
                <ui:VisualElement style="background-color: #FF6D00; padding: 16px; align-items: center;">
                    <ui:VisualElement class="logo-shield" style="width: 32px; height: 32px;" />
                    <ui:Label text="DGMS SAFETY CERTIFICATE" style="font-size: 13px; font-weight: 700; color: #FFFFFF; letter-spacing: 2px; margin-top: 6px;" />
                    <ui:Label text="Department of Mines Safety • Govt of Jharkhand" style="font-size: 10px; color: #FFE0B2; margin-top: 2px;" />
                </ui:VisualElement>

                <!-- Certificate Body Content -->
                <ui:VisualElement style="padding: 20px 16px; align-items: center;">
                    <ui:Label text="This is to certify that" style="font-size: 11px; color: #757575;" />
                    <ui:Label name="worker-name" text="Ramesh Kumar" style="font-size: 20px; font-weight: 700; color: #1A1A1A; margin-top: 4px;" />
                    
                    <ui:Label text="has successfully completed training for" style="font-size: 11px; color: #757575; margin-top: 8px;" />
                    <ui:Label name="module-title" text="Fire &amp; Explosion Safety" style="font-size: 15px; font-weight: 700; color: #FF6D00; margin-top: 4px; text-align: center;" />
                    
                    <!-- Score & Pass Badge Row -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; margin-top: 12px;">
                        <ui:Label text="Score:" style="font-size: 12px; color: #757575; margin-right: 4px;" />
                        <ui:Label name="score" text="88%" style="font-size: 16px; font-weight: 700; color: #1A1A1A; margin-right: 12px;" />
                        <ui:Label name="passed-badge" class="badge badge--pass" text="PASSED" />
                    </ui:VisualElement>

                    <!-- QR Code Display Box -->
                    <ui:VisualElement style="width: 140px; height: 140px; background-color: #FFFFFF; border-color: #E0E0E0; border-width: 1px; border-radius: 10px; align-items: center; justify-content: center; margin-top: 16px; padding: 6px;">
                        <ui:VisualElement name="qr-image" style="width: 110px; height: 110px; background-color: #FAFAFA; align-items: center; justify-content: center;">
                            <ui:Label text="[QR CODE]" style="font-size: 10px; color: #B0BEC5;" />
                        </ui:VisualElement>
                        <ui:Label name="cert-id" text="JH-FIRE-849201" style="font-size: 9px; font-weight: 700; color: #424242; margin-top: 4px;" />
                    </ui:VisualElement>
                    <ui:Label text="Official Verification QR Code" style="font-size: 10px; color: #9E9E9E; margin-top: 6px;" />

                    <!-- Certificate Metadata List -->
                    <ui:VisualElement style="width: 100%; margin-top: 20px; border-top-color: #EEEEEE; border-top-width: 1px; padding-top: 12px;">
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 6px;">
                            <ui:Label text="Certificate ID" style="font-size: 11px; color: #757575;" />
                            <ui:Label name="cert-id-meta" text="JH-FIRE-849201" style="font-size: 11px; font-weight: 600; color: #212121;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 6px;">
                            <ui:Label text="Issue Date" style="font-size: 11px; color: #757575;" />
                            <ui:Label name="issued-date" text="2026-09-03" style="font-size: 11px; color: #212121;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 6px;">
                            <ui:Label text="Valid Until" style="font-size: 11px; color: #757575;" />
                            <ui:Label name="expiry-date" text="2027-09-03" style="font-size: 11px; color: #212121;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 6px;">
                            <ui:Label text="Organization" style="font-size: 11px; color: #757575;" />
                            <ui:Label name="organization" text="Bharat Coking Coal Ltd" style="font-size: 11px; color: #212121;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                            <ui:Label text="Security Hash" style="font-size: 11px; color: #757575;" />
                            <ui:Label name="security-status" text="HMAC-SHA256 Signed" style="font-size: 10px; font-weight: 700; color: #2E7D32;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Worker Action Buttons -->
            <ui:VisualElement style="margin-top: 8px; padding: 0 16px;">
                <ui:Button class="btn-primary" name="download-btn" text="Download Certificate (PNG)" style="height: 44px; font-size: 13px; font-weight: 700;" />
                <ui:Button class="btn-secondary" name="share-btn" text="Share Certificate" style="height: 40px; margin-top: 8px; font-size: 12px;" />
            </ui:VisualElement>

            <!-- Bottom Spacer -->
            <ui:VisualElement style="height: 80px;" />
        </ui:ScrollView>

        <!-- Bottom Navigation Bar -->
        <ui:VisualElement name="bottom-nav" class="bottom-nav">
            <ui:Button name="tab-home" class="bottom-nav__tab">
                <ui:VisualElement class="icon-home" style="margin-bottom: 2px;" />
                <ui:Label class="bottom-nav__tab-label" text="Home" />
            </ui:Button>
            <ui:Button name="tab-training" class="bottom-nav__tab">
                <ui:VisualElement class="icon-training" style="margin-bottom: 2px;" />
                <ui:Label class="bottom-nav__tab-label" text="Training" />
            </ui:Button>
            <ui:Button name="tab-progress" class="bottom-nav__tab">
                <ui:VisualElement class="icon-progress" style="margin-bottom: 2px;" />
                <ui:Label class="bottom-nav__tab-label" text="Progress" />
            </ui:Button>
            <ui:Button name="tab-settings" class="bottom-nav__tab">
                <ui:VisualElement class="icon-settings" style="margin-bottom: 2px;" />
                <ui:Label class="bottom-nav__tab-label" text="Settings" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
