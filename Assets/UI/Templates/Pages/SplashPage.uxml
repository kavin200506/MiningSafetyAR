<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Theme.uss" />
    <Style src="project://database/Assets/UI/Styles/Reset.uss" />
    <Style src="project://database/Assets/UI/Styles/Components.uss" />
    <Style src="project://database/Assets/UI/Styles/Animations.uss" />
    <ui:VisualElement class="page-container" style="flex-grow: 1; background-color: #FFFFFF;">
        <ui:VisualElement class="splash" style="flex: 1; align-items: center; justify-content: center; padding: 40px 24px; background-color: #FFFFFF;">
            <ui:VisualElement class="splash__logo-box" style="width: 80px; height: 80px; border-radius: 20px; background-color: #FF6D00; align-items: center; justify-content: center; margin-bottom: 16px;">
                <ui:Label class="splash__logo-icon" text="&#x1F6E1;" style="font-size: 48px; color: #FFFFFF; text-align: center;" />
            </ui:VisualElement>
            <ui:Label class="splash__title" text="ARC" style="font-size: 36px; font-weight: 800; color: #1A1A1A; letter-spacing: 6px; margin-bottom: 4px;" />
            <ui:Label class="splash__subtitle" text="MineSafetyAr" style="font-size: 14px; font-weight: 600; color: #FF6D00; letter-spacing: 2px; margin-bottom: 8px;" />
            <ui:Label class="splash__desc" text="AR-Based Industrial Safety Training" style="font-size: 13px; color: #999999; margin-bottom: 40px;" />
            <ui:VisualElement class="splash__progress-track" style="width: 200px; height: 3px; background-color: #E0E0E0; border-radius: 2px;">
                <ui:VisualElement class="progress-fill" name="progress-fill" style="height: 100%; background-color: #FF6D00; width: 0%; border-radius: 2px;" />
            </ui:VisualElement>
            <ui:Label class="splash__status" name="status" text="Loading..." style="font-size: 11px; color: #CCCCCC; margin-top: 8px;" />
            <ui:VisualElement style="flex: 1;" />
            <ui:Label class="splash__footer" text="Powered by Government of Jharkhand" style="font-size: 11px; color: #999999; text-align: center;" />
            <ui:Label class="splash__footer-sub" text="Department of Higher &amp; Technical Education" style="font-size: 10px; color: #CCCCCC; text-align: center;" />
            <ui:Label class="splash__footer-id" text="PS: SIH26041" style="font-size: 10px; color: #FF6D00; font-weight: 600; text-align: center;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
