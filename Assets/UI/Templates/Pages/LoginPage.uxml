<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Theme.uss" />
    <Style src="project://database/Assets/UI/Styles/Reset.uss" />
    <Style src="project://database/Assets/UI/Styles/Components.uss" />
    <Style src="project://database/Assets/UI/Styles/Forms.uss" />
    <Style src="project://database/Assets/UI/Styles/Icons.uss" />
    <ui:VisualElement class="page-container" style="flex-grow: 1; background-color: #FFFFFF;">
        <ui:ScrollView style="flex: 1;">
            <ui:VisualElement class="login" style="align-items: center; padding: 40px 24px;">
                <ui:VisualElement class="login__logo-box" style="width: 80px; height: 80px; border-radius: 20px; background-color: #FF6D00; align-items: center; justify-content: center; margin-bottom: 16px;">
                    <ui:VisualElement class="logo-shield" style="width: 48px; height: 48px;" />
                </ui:VisualElement>
                <ui:Label class="login__title" text="ARC" style="font-size: 36px; font-weight: 800; color: #1A1A1A; letter-spacing: 6px;" />
                <ui:Label class="login__subtitle" text="MineSafetyAr" style="font-size: 14px; color: #FF6D00; letter-spacing: 2px; margin-bottom: 32px;" />
                <!-- Worker ID -->
                <ui:VisualElement class="form-group" style="width: 100%; margin-bottom: 16px;">
                    <ui:Label class="form-label" text="Worker ID" style="font-size: 11px; color: #666666; margin-bottom: 4px;" />
                    <ui:TextField class="input-field" name="worker-id" style="height: 48px;" />
                </ui:VisualElement>
                <!-- PIN -->
                <ui:VisualElement class="form-group" style="width: 100%; margin-bottom: 16px;">
                    <ui:Label class="form-label" text="PIN" style="font-size: 11px; color: #666666; margin-bottom: 4px;" />
                    <ui:VisualElement class="input-password" style="flex-direction: row; align-items: center; width: 100%;">
                        <ui:TextField class="input-field" name="pin" is-password-field="true" max-length="4" style="flex: 1; height: 48px;" />
                        <ui:Button class="pin-toggle" name="pin-toggle" style="width: 40px; height: 40px; justify-content: center; align-items: center; background-color: rgba(0,0,0,0); border-width: 0;">
                            <ui:VisualElement class="icon-eye" style="width: 20px; height: 20px;" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- Error -->
                <ui:Label class="login__error" name="error-msg" text="" style="font-size: 13px; color: #F44336; text-align: center; margin-bottom: 12px; display: none;" />
                <!-- Login Button -->
                <ui:Button class="btn-primary" name="login-btn" text="LOGIN" style="width: 100%; margin-top: 8px;" />
                <!-- Divider -->
                <ui:VisualElement class="divider" style="height: 1px; background-color: #E0E0E0; margin: 16px 0; width: 100%;" />
                <ui:Label class="login__or" text="OR" style="font-size: 12px; color: #999999; text-align: center;" />
                <!-- Demo -->
                <ui:Button class="btn-secondary" name="demo-btn" text="Demo Mode (Skip Login)" style="width: 100%; margin-top: 12px;" />
                <!-- Register -->
                <ui:Button class="btn-text" name="register-btn" text="Create New Account" style="margin-top: 16px;" />
                <!-- Footer -->
                <ui:Label class="login__lang" text="English" style="font-size: 12px; color: #999999; text-align: center; margin-top: 24px;" />
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
