<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="module-card" class="card-interactive module-card">
        <ui:VisualElement name="icon-box" class="module-card__icon-box" style="width: 48px; height: 48px; border-radius: 12px; align-items: center; justify-content: center; margin-right: 12px;">
            <ui:Label name="icon-emoji" class="module-card__icon-emoji" text="" style="font-size: 24px;" />
        </ui:VisualElement>
        <ui:VisualElement class="module-card__info" style="flex: 1;">
            <ui:Label name="module-title" class="module-card__title" text="" style="font-size: 14px; font-weight: 600; color: #1A1A1A;" />
            <ui:Label name="module-meta" class="module-card__meta" text="" style="font-size: 11px; color: #666666; margin-top: 2px;" />
            <ui:VisualElement name="progress-track" class="module-card__progress-track" style="height: 4px; background-color: #E0E0E0; border-radius: 2px; margin-top: 8px;">
                <ui:VisualElement name="progress-fill" class="progress-fill" style="height: 100%; background-color: #FF6D00; width: 0%;" />
            </ui:VisualElement>
            <ui:Label name="best-score" class="module-card__best-score" text="" style="font-size: 10px; color: #666666; margin-top: 4px;" />
        </ui:VisualElement>
        <ui:Label name="status-badge" class="badge module-card__status-badge" text="" style="margin-left: 8px;" />
    </ui:VisualElement>
</ui:UXML>
