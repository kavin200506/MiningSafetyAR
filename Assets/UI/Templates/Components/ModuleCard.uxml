<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="module-card" class="card-interactive module-card" style="flex-direction: row; align-items: center; background-color: rgb(255, 255, 255); border-radius: 20px; padding: 16px; margin-bottom: 16px; border-width: 1px; border-color: rgb(255, 237, 213);">
        <ui:VisualElement name="icon-box" class="module-card__icon-box" style="width: 56px; height: 56px; background-color: rgb(255, 243, 224); border-radius: 16px; align-items: center; justify-content: center; margin-right: 16px;">
            <ui:VisualElement name="icon-emoji" class="module-card__icon-emoji" style="width: 32px; height: 32px;" />
        </ui:VisualElement>
        <ui:VisualElement class="module-card__info" style="flex: 1;">
            <ui:Label name="module-title" class="module-card__title" text="Module Title" style="font-size: 16px; font-weight: 700; color: rgb(26, 26, 26); -unity-font-style: bold; margin-bottom: 4px;" />
            <ui:Label name="module-meta" class="module-card__meta" text="Meta Info" style="font-size: 12px; color: rgb(153, 153, 153);" />
            <ui:VisualElement name="progress-track" class="module-card__progress-track" style="height: 6px; background-color: rgb(255, 237, 213); border-radius: 3px; margin-top: 12px; overflow: hidden;">
                <ui:VisualElement name="progress-fill" class="progress-fill" style="height: 100%; background-color: rgb(255, 109, 0); width: 0%;" />
            </ui:VisualElement>
            <ui:Label name="best-score" class="module-card__best-score" text="Score: 0%" style="font-size: 11px; font-weight: 600; color: rgb(255, 109, 0); margin-top: 6px; -unity-font-style: bold;" />
        </ui:VisualElement>
        <ui:Label name="status-badge" class="badge module-card__status-badge" text="NEW" style="margin-left: 12px; background-color: rgb(232, 245, 233); color: rgb(76, 175, 80); padding: 4px 10px; border-radius: 12px; font-size: 10px; font-weight: 700; -unity-font-style: bold;" />
    </ui:VisualElement>
</ui:UXML>
