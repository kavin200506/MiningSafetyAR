<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="module-card" class="card-interactive module-card" style="flex-direction: row; background-color: rgb(255, 255, 255); border-radius: 16px; margin-bottom: 16px; border-width: 1px; border-color: rgb(240, 240, 240); padding: 0; overflow: hidden; height: auto; min-height: 110px;">
        
        <!-- Image Slot: Flush to the left, full height -->
        <ui:VisualElement name="icon-box" class="module-card__icon-box" style="width: 100px; background-color: rgb(255, 243, 224); align-items: center; justify-content: center; align-self: stretch;">
            <!-- The actual icon will go here, currently empty by default -->
            <ui:VisualElement name="icon-emoji" class="module-card__icon-emoji" style="width: 48px; height: 48px; -unity-background-scale-mode: scale-to-fit;" />
        </ui:VisualElement>
        
        <!-- Content Area: Right side -->
        <ui:VisualElement class="module-card__info" style="flex: 1; padding: 16px; justify-content: center;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: flex-start; margin-bottom: 4px;">
                <ui:Label name="module-title" class="module-card__title" text="Module Title" style="font-size: 16px; font-weight: 700; color: rgb(26, 26, 26); -unity-font-style: bold; flex: 1; white-space: normal;" />
                <ui:Label name="status-badge" class="badge module-card__status-badge" text="NEW" style="background-color: rgb(232, 245, 233); color: rgb(76, 175, 80); padding: 4px 8px; border-radius: 10px; font-size: 10px; font-weight: 700; -unity-font-style: bold; margin-left: 8px;" />
            </ui:VisualElement>
            
            <ui:Label name="module-meta" class="module-card__meta" text="Meta Info" style="font-size: 12px; color: rgb(153, 153, 153);" />
            
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-top: 12px;">
                <ui:VisualElement name="progress-track" class="module-card__progress-track" style="flex: 1; height: 6px; background-color: rgb(245, 245, 245); border-radius: 3px; overflow: hidden; margin-right: 12px;">
                    <ui:VisualElement name="progress-fill" class="progress-fill" style="height: 100%; background-color: rgb(255, 109, 0); width: 0%;" />
                </ui:VisualElement>
                <ui:Label name="best-score" class="module-card__best-score" text="0%" style="font-size: 12px; font-weight: 700; color: rgb(255, 109, 0); -unity-font-style: bold;" />
            </ui:VisualElement>
        </ui:VisualElement>
        
    </ui:VisualElement>
</ui:UXML>
