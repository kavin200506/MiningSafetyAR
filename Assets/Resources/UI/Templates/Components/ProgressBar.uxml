<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="progress-track" class="progress-track" style="height: 6px; background-color: #E0E0E0; border-radius: 3px;">
        <ui:VisualElement name="progress-fill" class="progress-fill" style="height: 100%; background-color: #FF6D00; width: 0%; border-radius: 3px;" />
    </ui:VisualElement>
</ui:UXML>
